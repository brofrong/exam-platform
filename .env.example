# App (typed in src/shared/env.ts)
APP_URL="http://localhost:3000"
ZERO_UPSTREAM_DB="postgres://postgres:pass@localhost:5432/zero"
ZERO_CACHE_UPSTREAM_URL="http://localhost:4848"

# Optional. If unset, a secret is generated once and stored in app_setting.
# Prefer setting this explicitly for multi-instance / production.
# BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# Zero cache container (docker/docker-compose.dev.yml) — not read by the app,
# but required so Zero can call back into query/mutate handlers.
ZERO_QUERY_URL="http://localhost:3000/api/query"
ZERO_MUTATE_URL="http://localhost:3000/api/mutate"

# MinIO / S3 (docker/docker-compose.dev.yml — API :9000, console :9001)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_UPLOADS="exam-platform-uploads"
S3_REGION="us-east-1"
