{
  "name": "zero-test",
  "private": true,
  "type": "module",
  "packageManager": "bun@canary",
  "engines": {
    "bun": ">=1.3.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --host",
    "dev:e2e": "vite dev --port 3100 --host",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "bun run server.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e:infra": "docker compose -f docker/docker-compose.e2e.yml up -d --wait",
    "test:e2e:infra:down": "docker compose -f docker/docker-compose.e2e.yml down -v",
    "test:e2e:prepare": "bun --env-file=.env.e2e run db:migrate",
    "test:e2e": "bun run test:e2e:infra && bun run test:e2e:prepare && playwright test",
    "test:e2e:ui": "bun run test:e2e:infra && bun run test:e2e:prepare && playwright test --ui",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "zero:generate": "drizzle-zero generate --schema src/server/db/schema.ts --output src/server/zero/schema.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@rocicorp/zero": "^1.7.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "better-auth": "^1.6.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "lucide-react": "^0.545.0",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "drizzle-zero": "^1.0.0-beta.1",
    "jsdom": "^28.1.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "trustedDependencies": [
    "@rocicorp/zero-sqlite3",
    "esbuild",
    "lightningcss"
  ]
}
