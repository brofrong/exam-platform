{
	"name": "exam-platform",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.0"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000 --host",
		"dev:e2e": "vite dev --port 3100 --host",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"start": "bun run server.ts",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "bun test src",
		"test:e2e:infra": "docker compose -f docker/docker-compose.e2e.yml up -d --wait zero-postgres-e2e zero-cache-e2e minio-e2e && docker compose -f docker/docker-compose.e2e.yml up --no-deps minio-e2e-init",
		"test:e2e:infra:down": "docker compose -f docker/docker-compose.e2e.yml down -v",
		"test:e2e:prepare": "bun --env-file=.env.e2e run db:migrate",
		"test:e2e": "bun run test:e2e:infra && bun run test:e2e:prepare && playwright test",
		"test:e2e:ui": "bun run test:e2e:infra && bun run test:e2e:prepare && playwright test --ui",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"zero:generate": "drizzle-zero generate --schema src/server/db/schema.ts --output src/server/zero/schema.ts --force && bun run scripts/fix-zero-schema.ts",
		"smoke:s3": "bun --env-file=.env run scripts/smoke-s3.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1094.0",
		"@aws-sdk/s3-request-presigner": "^3.1094.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/literata": "^5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@rocicorp/zero": "^1.7.0",
		"@t3-oss/env-core": "^0.13.11",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "0.10.8",
		"@tanstack/react-router": "1.170.17",
		"@tanstack/react-router-devtools": "1.167.0",
		"@tanstack/react-router-ssr-query": "1.167.1",
		"@tanstack/react-start": "1.168.27",
		"@tanstack/router-plugin": "1.168.19",
		"@tiptap/core": "^3.29.0",
		"@tiptap/pm": "^3.29.0",
		"@tiptap/react": "^3.29.0",
		"@tiptap/starter-kit": "^3.29.0",
		"better-auth": "^1.6.24",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^1.0.0-rc.4",
		"lucide-react": "^0.545.0",
		"mafs": "^0.21.0",
		"pg": "^8.22.0",
		"radix-ui": "^1.6.5",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-live": "^4.1.8",
		"shadcn": "^4.14.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@playwright/test": "^1.61.1",
		"@tanstack/devtools-vite": "0.8.1",
		"@tanstack/router-cli": "1.167.18",
		"@types/bun": "^1.3.14",
		"@types/node": "^22.10.2",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^1.0.0-rc.4",
		"drizzle-zero": "^1.0.0-beta.1",
		"tsx": "^4.23.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0"
	},
	"trustedDependencies": [
		"@rocicorp/zero-sqlite3",
		"esbuild",
		"lightningcss"
	]
}
